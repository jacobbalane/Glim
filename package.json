{
  "name": "glim",
  "version": "0.1.0",
  "private": true,
  "description": "Your agents, at a glance. A Windows desktop island for Claude Code and Codex.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "desktop",
    "contracts",
    "vscode-extension"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @glim/desktop",
    "build": "npm run build --workspace @glim/desktop && npm run build --workspace glim-vscode",
    "check": "tsc --noEmit && tsc --noEmit -p vscode-extension/tsconfig.json",
    "test": "tsx --test contracts/src/*.test.ts scripts/*.test.ts",
    "desktop": "node scripts/tauri.mjs dev",
    "package:windows": "node scripts/tauri.mjs build --bundles nsis --config src-tauri/tauri.bundle.conf.json",
    "package:msix": "node scripts/package-msix.mjs",
    "native:prepare": "node scripts/prepare-native.mjs",
    "package:extension": "npm run package --workspace glim-vscode",
    "probe:codex": "node scripts/probe-codex.mjs",
    "test:ui": "playwright test",
    "format": "prettier --write desktop/src desktop/vite.config.ts contracts/src vscode-extension/src scripts tests playwright.config.ts",
    "format:check": "prettier --check desktop/src desktop/vite.config.ts contracts/src vscode-extension/src scripts tests playwright.config.ts",
    "test:relay": "node scripts/test-relay.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.138.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
