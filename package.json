{
  "name": "glim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:capture": "node scripts/capture-previews.mjs",
    "brand:render": "node scripts/render-brand.mjs",
    "installer:art": "node scripts/render-installer-art.mjs",
    "site": "vite --config site/vite.config.ts",
    "site:build": "tsc -p site && vite build --config site/vite.config.ts",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:native": "node scripts/native-smoke.mjs",
    "test:install": "powershell -NoProfile -File scripts/install-smoke.ps1",
    "tauri": "tauri",
    "desktop": "node scripts/prepare-bridge.mjs && tauri dev",
    "package": "node scripts/prepare-bridge.mjs --release && tauri build",
    "check:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write src scripts tests *.ts *.json *.md docs .github/workflows && cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^1.52.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource-variable/unbounded": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ogl": "^1.0.11",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
