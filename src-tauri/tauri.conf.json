{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glim",
  "version": "0.1.3",
  "identifier": "dev.glim.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "theme": "Dark",
        "title": "Glim",
        "width": 680,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "externalBin": ["binaries/glim-bridge"],
    "resources": {
      "../LICENSE": "licenses/glim.txt",
      "../public/fonts/Manrope-LICENSE.txt": "licenses/manrope.txt",
      "../public/licenses/three.txt": "licenses/three.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/third-party-notices.md"
    },
    "shortDescription": "A glimpse at your local coding agents",
    "longDescription": "Live activity, token usage, and progress for Claude Code and Codex, in a minimal desktop island. Local by design.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/crowd.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header-uninstall.bmp",
        "customLanguageFiles": {
          "English": "installer/english.nsh"
        },
        "template": "installer/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyRTQ4MUUwOUUwRjM1QTcKUldTbk5RK2U0SUhrRWc1VFExNUpvemhiSUNaMVJ5d2V1dnpSckdTNVk4NUR6OUVKYjhxa0wvT08K",
      "endpoints": ["https://github.com/jacobbalane/Glim/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
